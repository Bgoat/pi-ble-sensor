[Unit]
Description=wingSpan BLE sensor
After=network.target bluetooth.target sound.target

[Service]
Type=simple
User=beehaus
Group=beehaus
WorkingDirectory=/home/beehaus
Environment=HOME=/home/beehaus
ExecStartPre=+/home/beehaus/wingspan-boot.sh
ExecStart=/usr/bin/python3 /home/beehaus/sensor_ble.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
